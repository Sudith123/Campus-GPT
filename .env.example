# GEMINI_API_KEY: Required for server-side Gemini AI API calls and embeddings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing/hashing authentication session tokens.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# ALLOWED_COLLEGE_DOMAIN: Authorized college domain policy for registration.
ALLOWED_COLLEGE_DOMAIN="meridian.edu.in"

# Optional SMTP Configuration for Email OTP & Password Reset Delivery
# When unconfigured, OTP delivery is disabled in production mode and clearly indicated.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@meridian.edu.in"
